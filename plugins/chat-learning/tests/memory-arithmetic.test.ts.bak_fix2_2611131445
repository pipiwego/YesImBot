/** 构造与目标向量余弦恰为 cos 的单位向量。 */
function unitVector(cos: number): readonly number[] {
  return [cos, Math.sqrt(Math.max(0, 1 - cos * cos))];
}

function bankWithPattern(phrase: string, embedding: readonly number[], channelKey = "old"): GlobalRuleBank {
  const pattern: GlobalPattern = {
    kind: "response",
    intent: "agree",
    phrase,
    channels: [{ key: channelKey, frequency: 1, lastSeenAt: 1 }],
    firstSeenAt: 1,
    lastSeenAt: 1,
    embedding: [...embedding],
  };
  return { version: 1, updatedAt: 1, patterns: [pattern], chains: [], templates: [], boundaries: [] };
}

function turn(id: string, timestamp: number, text: string, userId = "u1", userName = "Alice"): MessageTurn {
  return {
    id,
    messageId: id,
    userId,
    userName,
    timestamp,
    text,
    elementKinds: ["text"],
    hasImage: false,
    quoteId: undefined,
    quoteType: undefined,
    mentionIds: [],
  };
}

function state(): ChatLearningState {
