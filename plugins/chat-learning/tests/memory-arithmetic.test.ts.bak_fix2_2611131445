  const current = [turn("t1", 1000, "这个方案靠谱吗"), turn("t2", 2000, "确实", "u2", "Bob")];
  return {
    lastEntryId: "t2",
    builtAt: 3000,
    turns: [...historical, ...current],
    links: [],
    segments: [
      { id: "s0", startTime: 100, endTime: 200, turns: historical },
      { id: "s1", startTime: 1000, endTime: 2000, turns: current },
