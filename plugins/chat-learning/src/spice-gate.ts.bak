      read: "结局已定或即将翻车，但损失很轻（游戏/小Flag/自己的小倒霉），适合自嘲或轻量看乐子",
      words: [
        { w: "寄", e: 1, t: "thing", pos: "单独一个字或'这不得寄'", priv: false },
        { w: "我寄了", e: 0, t: "self", pos: "只用于说你自己", priv: true },
        { w: "似了", e: 1, t: "thing", pos: "句尾" },
