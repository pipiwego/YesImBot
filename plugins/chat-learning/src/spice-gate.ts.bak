      read: "事情荒诞好笑，但没人真受伤",
      words: [
        { w: "难绷", e: 1, t: "thing", pos: "单独一行或句首", priv: true },
        { w: "草", e: 0, t: "self", pos: "单独一个字", priv: true },
        { w: "笑死", e: 0, t: "self", pos: "句首", priv: true },
        { w: "绷不住了", e: 1, t: "self", pos: "句尾", priv: true },
