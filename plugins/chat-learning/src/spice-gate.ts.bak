// spice-gate.ts —— 语气词稀疏门控 + 冲度预算 + 软调料盘（内联词表，无 JSON import 依赖）

type Word = {
  readonly w: string;
  readonly e: number;
  readonly t: "thing" | "self" | "person";
  readonly pos: string;
  readonly priv?: boolean;
};

type Cluster = {
  readonly id: string;
  readonly base: number;
  readonly minSafety: number;
  readonly moves: readonly string[];
  readonly cue: string;
  readonly read: string;
  readonly words: readonly Word[];
  readonly needBanter?: boolean;
};

export interface TurnCtx {
  channel: string;
  isPrivate: boolean;
  isMaster: boolean;
  text: string;
  sceneGate?: "work_delivery" | "comfort" | "casual"; // 向量/LLM 传入的场景闸门
  inMove?: string; // 向量/LLM 传入的 15 类 in_move 分类结果
  safety: 0 | 1 | 2 | 3; // 0生人 1普通群友 2互损老友 3Misaki(群里)
  hour: number;
  mood?: number; // mood: -1烦躁 0平 1开心（情绪余温）
  lastBotReply?: string;
}

interface ChanState {
  turn: number;
  budget: number;
  cool: number;
  recent: string[];
  hurt: number;
  banter: number;
}

const SPICE_TABLE = {
  veto: "难过|想哭|哭了|分手|挂科|被裁|裁员|生病|住院|去世|走了|焦虑|抑郁|失眠|崩溃了|撑不住|好累|不想活",
