import { createHash } from "node:crypto";
import { mkdir, readFile, rename, rm, writeFile } from "node:fs/promises";
import { dirname } from "node:path";

import { cosineSimilarity } from "./embedding.js";
import { computeSalience, detectBoundary } from "./salience.js";
import type {
  BoundaryMemory,
  GlobalChainSample,
  GlobalChainPattern,
  GlobalPattern,
  GlobalPatternKind,
  GlobalRuleBank,
  InitiationPattern,
  LocalChainSample,
  LocalChainPattern,
  MemeTemplate,
  ResponsePattern,
} from "./types.js";

export interface GlobalRuleStore {
  init(): Promise<void>;
  read(): GlobalRuleBank;
  update(next: GlobalRuleBank): Promise<void>;
  /** 锁内读-合并-写，避免并发同步时后写覆盖先写的增量。 */
  updateWith(mutate: (current: GlobalRuleBank) => GlobalRuleBank): Promise<GlobalRuleBank>;
}

export function createGlobalRuleStore(filePath: string): GlobalRuleStore {
  let bank: GlobalRuleBank = createEmptyGlobalRuleBank();
  let tail: Promise<void> = Promise.resolve();

  const serialize = <T>(task: () => Promise<T>): Promise<T> => {
    const next = tail.then(task, task);
    tail = next.then(
      () => undefined,
      () => undefined,
    );
    return next;
  };

  return {
    async init() {
      await serialize(async () => {
        try {
          const content = await readFile(filePath, "utf8");
          bank = content.trim().length > 0 ? normalizeGlobalRuleBank(JSON.parse(content)) : createEmptyGlobalRuleBank();
        } catch (error) {
          if ((error as NodeJS.ErrnoException).code !== "ENOENT") bank = createEmptyGlobalRuleBank();
        }
      });
    },
    read() {
      return bank;
    },
    update(next) {
      return serialize(async () => {
        bank = next;
        await mkdir(dirname(filePath), { recursive: true });
        const temporary = `${filePath}.${Date.now()}.tmp`;
        await writeFile(temporary, `${JSON.stringify(next, null, 2)}\n`, { encoding: "utf8", flag: "wx" });
        try {
          await rename(temporary, filePath);
        } finally {
          await rm(temporary, { force: true });
        }
      });
    },
    /**
     * 锁内「读当前 → 合并 → 写回」。
     * 直接用 update() 的话，调用方在 await 之前取到的快照可能是旧的，
     * 两个频道并发同步时后写的一方会覆盖掉先写的增量（patterns / boundaries 一起丢）。
     */
    updateWith(mutate) {
      return serialize(async () => {
        const next = mutate(bank);
        bank = next;
        await mkdir(dirname(filePath), { recursive: true });
        const temporary = `${filePath}.${Date.now()}.tmp`;
        await writeFile(temporary, `${JSON.stringify(next, null, 2)}\n`, { encoding: "utf8", flag: "wx" });
        try {
          await rename(temporary, filePath);
        } finally {
          await rm(temporary, { force: true });
        }
        return next;
      });
    },
  };
}

export function createEmptyGlobalRuleBank(): GlobalRuleBank {
  return { version: 1, updatedAt: Date.now(), patterns: [], chains: [], templates: [], boundaries: [] };
}

export interface MergeLocalPatternsOptions {
  localEmbeddings?: ReadonlyMap<string, readonly number[]>;
  embeddingSimilarity?: number;
  clusterSimilarity?: number;
  /** 最近对话原文，用于边界判定（全局同步时由 index.ts 传入）。 */
  boundaryTexts?: readonly string[];
}

const DEFAULT_MERGE_SIMILARITY = 0.92;
const DEFAULT_CLUSTER_SIMILARITY = 0.85;
const MAX_VARIANTS = 4;

export function mergeLocalPatterns(
  bank: GlobalRuleBank,
  responsePatterns: readonly ResponsePattern[],
  initiationPatterns: readonly InitiationPattern[],
  chainPatterns: readonly LocalChainPattern[],
  scopeKey: string,
  now: number,
  options: MergeLocalPatternsOptions = {},
): GlobalRuleBank {
  const byKey = new Map<string, GlobalPattern>();
  for (const pattern of normalizePatternRows(Array.isArray(bank.patterns) ? bank.patterns : [])) {
    byKey.set(patternPhraseKey(pattern.phrase), cloneGlobalPattern(pattern));
  }
  const byChainKey = new Map<string, GlobalChainPattern>(bank.chains.map((chain) => [chainKey(chain.chain), cloneGlobalChain(chain)]));
  const channelKey = channelFingerprint(scopeKey);
  const mergeSimilarity = options.embeddingSimilarity ?? DEFAULT_MERGE_SIMILARITY;
  const clusterSimilarity = options.clusterSimilarity ?? DEFAULT_CLUSTER_SIMILARITY;

  for (const pattern of responsePatterns) {
    mergePatternWithEmbedding(
      byKey,
      "response",
      pattern.intent,
      pattern.phrase,
      pattern.frequency,
      channelKey,
      now,
      options.localEmbeddings?.get(`response:${pattern.intent}:${pattern.phrase}`),
      mergeSimilarity,
      clusterSimilarity,
    );
  }
  for (const pattern of initiationPatterns) {
    mergePatternWithEmbedding(
      byKey,
      "initiation",
      pattern.intent,
      pattern.phrase,
      pattern.frequency,
      channelKey,
      now,
      options.localEmbeddings?.get(`initiation:${pattern.intent}:${pattern.phrase}`),
      mergeSimilarity,
      clusterSimilarity,
    );
  }
  for (const chain of chainPatterns) {
    mergeChainPattern(byChainKey, chain.chain, chain.frequency, channelKey, now, chain.sample, chain.style, chain.styleSampleId, chain.semantics);
  }

  const boundaries = options.boundaryTexts && options.boundaryTexts.length > 0
    ? mergeBoundaries(bank.boundaries ?? [], options.boundaryTexts, channelKey, now)
    : (bank.boundaries ?? []).map(cloneBoundary);

  return {
    version: bank.version,
    updatedAt: now,
    patterns: [...byKey.values()].sort(byScore),
    chains: [...byChainKey.values()].sort(byChainScore),
    templates: bank.templates ?? [],
    boundaries,
  };
}

/** kind 是列属性：老数据只有 kind 时退化为单元素数组。 */
export function kindsOf(pattern: GlobalPattern): readonly GlobalPatternKind[] {
  return pattern.kinds && pattern.kinds.length > 0 ? pattern.kinds : [pattern.kind];
}

export function intentsOf(pattern: GlobalPattern): readonly string[] {
  return pattern.intents && pattern.intents.length > 0 ? pattern.intents : [pattern.intent];
}

export function selectGlobalPatterns(bank: GlobalRuleBank, kind: GlobalPatternKind, minChannels: number, max: number): readonly GlobalPattern[] {
  return bank.patterns
    .filter((pattern) => kindsOf(pattern).includes(kind) && pattern.channels.length >= minChannels)
    .sort(byScore)
    .slice(0, max);
}

/**
 * 边界与 patterns 最本质的差别：不受 minGlobalChannels 约束、不衰减，只要未撤销就返回。
 * 容量只做「留最近 50 条」的截断，不删除任何条目。
 */
/**
 * 选边界。给了 channelKey 就只返回该频道的边界——边界是「谁对谁说的」，
 * 跨频道注入等于把一个私聊对象的话变成所有人的硬约束。
 *
 * 排序用 strength（max 聚合、不衰减）而不是 lastSeenAt：
 * 按最后出现时间排会让久未重申的真禁忌被新条目静默挤出注入集合。
 */
export function selectBoundaries(
  bank: GlobalRuleBank,
  max = 50,
  channelKey?: string,
): readonly BoundaryMemory[] {
  return (bank.boundaries ?? [])
    .filter((boundary) => boundary.revokedAt === undefined)
    .filter((boundary) => channelKey === undefined || boundary.channelKey === channelKey)
    .slice()
    .sort((left, right) => right.strength - left.strength || right.lastSeenAt - left.lastSeenAt)
    .slice(0, max);
}

export function selectGlobalChains(bank: GlobalRuleBank, minChannels: number, max: number): readonly GlobalChainPattern[] {
  return bank.chains
    .filter((chain) => chain.channels.length >= minChannels)
    .sort(byChainScore)
    .slice(0, max);
}

export function selectGlobalMemeTemplates(bank: GlobalRuleBank, max: number): readonly MemeTemplate[] {
  return (bank.templates ?? []).slice(0, max);
}

export function selectRelevantGlobalChains(bank: GlobalRuleBank, currentText: string, minChannels: number, max: number): readonly GlobalChainPattern[] {
  const query = normalizeRelevanceText(currentText);
  if (query.length === 0) return [];
  return bank.chains
    .filter((chain) => chain.channels.length >= minChannels)
    .map((chain) => ({ chain, score: chainRelevanceScore(chain, query) }))
    .filter((candidate) => candidate.score > 0)
    .sort((left, right) => right.score - left.score || chainScore(right.chain) - chainScore(left.chain))
    .slice(0, max)
    .map((candidate) => candidate.chain);
}

function mergePatternWithEmbedding(
  byKey: Map<string, GlobalPattern>,
  kind: GlobalPatternKind,
  intent: string,
  phrase: string,
  frequency: number,
  channelKey: string,
  now: number,
  embedding: readonly number[] | undefined,
  mergeSimilarity: number,
  clusterSimilarity: number,
): void {
  const key = patternPhraseKey(phrase);
  const exact = byKey.get(key);
  // 与旧实现保持一致：embeddingSimilarity ≥ 1 视为关闭语义归并。
  const best = mergeSimilarity >= 1 ? undefined : bestMatch(byKey, embedding);
  const matched = exact ? { pattern: exact, cosine: 1, cluster: false } : classifyMatch(best, mergeSimilarity, clusterSimilarity);

  if (matched) {
    const target = matched.pattern;
    const targetKey = patternPhraseKey(target.phrase);
    const isSamePhrase = targetKey === key;
    const updated: GlobalPattern = {
      ...target,
      kind: target.kind,
      intent: target.intent,
      kinds: unionKinds(target, kind),
      intents: unionIntents(target, intent),
      variants: isSamePhrase || !matched.cluster ? target.variants : addVariant(target.variants, phrase),
      salience: target.salience ?? clampSalience(computeSalience(phrase, { maxCosine: matched.cosine })),
      hits: (target.hits ?? 0) + 1,
      channels: mergeChannelStats(target.channels, channelKey, frequency, now),
      lastSeenAt: now,
      ...(target.embedding ? { embedding: [...target.embedding] } : embedding ? { embedding: [...embedding] } : {}),
    };
    byKey.set(targetKey, updated);
    return;
  }

  byKey.set(key, {
    kind,
    intent,
    kinds: [kind],
    intents: [intent],
    phrase,
    channels: [{ key: channelKey, frequency, lastSeenAt: now }],
    firstSeenAt: now,
    lastSeenAt: now,
    salience: clampSalience(computeSalience(phrase, { maxCosine: best?.cosine })),
    hits: 1,
    ...(embedding ? { embedding: [...embedding] } : {}),
  });
}

function classifyMatch(
  best: { pattern: GlobalPattern; cosine: number } | undefined,
  mergeSimilarity: number,
  clusterSimilarity: number,
): { pattern: GlobalPattern; cosine: number; cluster: boolean } | undefined {
  if (!best) return undefined;
  if (best.cosine >= mergeSimilarity) return { ...best, cluster: false };
  // cluster 档必须严格低于 merge 档，否则两个阈值重合时语义会打架。
  if (clusterSimilarity < mergeSimilarity && best.cosine >= clusterSimilarity) return { ...best, cluster: true };
  return undefined;
}

/** 取最高余弦的那条（0.85 档必须取 max，不能命中第一条就返回）。 */
function bestMatch(byKey: Map<string, GlobalPattern>, embedding: readonly number[] | undefined): { pattern: GlobalPattern; cosine: number } | undefined {
  if (!embedding) return undefined;
  let best: { pattern: GlobalPattern; cosine: number } | undefined;
  for (const pattern of byKey.values()) {
    if (!pattern.embedding) continue;
    const cosine = cosineSimilarity(embedding, pattern.embedding);
    if (!best || cosine > best.cosine) best = { pattern, cosine };
  }
  return best;
}

function mergeChannelStats(channels: readonly { key: string; frequency: number; lastSeenAt: number }[], channelKey: string, frequency: number, now: number) {
  const next = channels.map((channel) => ({ ...channel }));
  const index = next.findIndex((channel) => channel.key === channelKey);
  if (index >= 0) {
    next[index] = { key: channelKey, frequency, lastSeenAt: now };
  } else {
    next.push({ key: channelKey, frequency, lastSeenAt: now });
  }
  return next;
}

function unionKinds(pattern: GlobalPattern, kind: GlobalPatternKind): readonly GlobalPatternKind[] {
  const kinds = kindsOf(pattern);
  return kinds.includes(kind) ? kinds : [...kinds, kind];
}

function unionIntents(pattern: GlobalPattern, intent: string): readonly string[] {
  const intents = intentsOf(pattern);
  return intents.includes(intent) ? intents : [...intents, intent];
}

function addVariant(variants: readonly string[] | undefined, phrase: string): readonly string[] {
  const current = variants ?? [];
  if (current.includes(phrase)) return current;
  return [...current, phrase].slice(-MAX_VARIANTS);
}

function clampSalience(value: number): number {
  return value < 0 ? 0 : value > 1 ? 1 : value;
}

function cloneBoundary(boundary: BoundaryMemory): BoundaryMemory {
  return { ...boundary };
}

/** 边界合并：同一句只留一条（id 由归一化文本决定），strength 取 max，不衰减。 */
export function mergeBoundaries(
  boundaries: readonly BoundaryMemory[],
  texts: readonly string[],
  channelKey: string,
  now: number,
): readonly BoundaryMemory[] {
  const next = boundaries.map(cloneBoundary);
  for (const raw of texts) {
    const text = normalizeBoundaryText(raw);
    if (text.length < 2 || text.length > 120) continue;
    const detection = detectBoundary(text);
    if (!detection.hit) continue;
    const id = boundaryId(channelKey, text);
    const index = next.findIndex((boundary) => boundary.id === id);
    if (index >= 0) {
      const existing = next[index]!;
      next[index] = {
        ...existing,
        // max 聚合：被无视后反复重申不会抬高权重。
        strength: Math.max(existing.strength, detection.score),
        hits: existing.hits + 1,
        lastSeenAt: now,
      };
    } else {
      next.push({
        id,
        text,
        channelKey,
        firstSeenAt: now,
        lastSeenAt: now,
        strength: detection.score,
        hits: 1,
      });
    }
  }
  return next;
}

function normalizeBoundaryText(value: string): string {
  return value.replace(/\s+/g, " ").trim();
}

/**
 * 边界 id 带上 channelKey：同一个人在不同频道说的同一句话不应合并成一条。
 * 否则某人对 A 说的禁忌会被当成对所有人的通用约束。
 */
function boundaryId(channelKey: string, text: string): string {
  return createHash("sha256").update(`${channelKey}\u0000${text}`).digest("hex").slice(0, 16);
}

/** 把 scope 换算成与 mergeBoundaries 一致的 channelKey。 */
export function channelKeyOfScope(scopeKey: string): string {
  return channelFingerprint(scopeKey);
}

function cloneGlobalPattern(pattern: GlobalPattern): GlobalPattern {
  return {
    ...pattern,
    kinds: kindsOf(pattern),
    intents: intentsOf(pattern),
    channels: pattern.channels.map((channel) => ({ ...channel })),
    ...(pattern.variants ? { variants: [...pattern.variants] } : {}),
    ...(pattern.embedding ? { embedding: [...pattern.embedding] } : {}),
  };
}

function mergeChainPattern(
  byKey: Map<string, GlobalChainPattern>,
  chain: readonly string[],
  frequency: number,
  channelKey: string,
  now: number,
  sample: LocalChainSample | undefined,
  style: string | undefined,
  styleSampleId: string | undefined,
  semantics: string | undefined,
): void {
  const key = chainKey(chain);
  const existing = byKey.get(key);
  if (!existing) {
    byKey.set(key, {
      chain: [...chain],
      samples: sample ? [{ ...sample, channelKey }] : [],
      style,
      styleSampleId,
      semantics,
      channels: [{ key: channelKey, frequency, lastSeenAt: now }],
      firstSeenAt: now,
      lastSeenAt: now,
    });
    return;
  }

  const channelIndex = existing.channels.findIndex((channel) => channel.key === channelKey);
  const channels = [...existing.channels];
  if (channelIndex >= 0) {
    channels[channelIndex] = { ...channels[channelIndex]!, frequency, lastSeenAt: now };
  } else {
    channels.push({ key: channelKey, frequency, lastSeenAt: now });
  }
  const samples = existing.samples ? existing.samples.map((item) => ({ ...item })) : [];
  if (sample && !samples.some((item) => sameSample(item, sample))) {
    samples.push({ ...sample, channelKey });
  }
  const styleChanged = style !== undefined && styleSampleId !== undefined && existing.styleSampleId !== styleSampleId;
  const nextStyle = styleChanged ? style : (existing.style ?? style);
  const nextStyleSampleId = styleChanged ? styleSampleId : (existing.styleSampleId ?? styleSampleId);
  byKey.set(key, {
    ...existing,
    style: nextStyle,
    styleSampleId: nextStyleSampleId,
    semantics: existing.semantics ?? semantics,
    samples: samples.slice(-2),
    channels,
    lastSeenAt: now,
  });
}

function cloneGlobalChain(chain: GlobalChainPattern): GlobalChainPattern {
  return {
    ...chain,
    chain: [...chain.chain],
    style: chain.style,
    styleSampleId: chain.styleSampleId,
    semantics: chain.semantics,
    samples: chain.samples?.map((sample) => ({ ...sample, turns: sample.turns.map((turn) => ({ ...turn })) })),
    channels: chain.channels.map((channel) => ({ ...channel })),
  };
}

function sameSample(left: GlobalChainSample, right: LocalChainSample): boolean {
  if (left.turns.length !== right.turns.length) return false;
  return left.turns.every((turn, index) => turn.text === right.turns[index]?.text && turn.speaker === right.turns[index]?.speaker);
}

function chainRelevanceScore(chain: GlobalChainPattern, query: string): number {
  let best = 0;
  for (const sample of chain.samples ?? []) {
    for (const turn of sample.turns) {
      const candidate = normalizeRelevanceText(turn.text);
      if (candidate.length === 0) continue;
      best = Math.max(best, textSimilarity(query, candidate));
    }
  }
  return best;
}

function normalizeRelevanceText(value: string): string {
  return value
    .replace(/\[time=[^\]]*\]/g, " ")
    .replace(/data:[^"'\s>]+/gi, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/asset:\/\/[a-f0-9]+/gi, " ")
    .replace(/https?:\/\/\S+/gi, " ")
    .replace(/@\S+/g, "@")
    .replace(/[\s\p{P}\p{S}\p{C}]+/gu, "")
    .toLowerCase();
}

function textSimilarity(left: string, right: string): number {
  if (left === right) return 1;
  if (left.length === 0 || right.length === 0) return 0;
  if (left.includes(right) || right.includes(left)) return 0.6;
  const leftChars = new Set(left);
  const rightChars = new Set(right);
  let intersection = 0;
  for (const char of leftChars) {
    if (rightChars.has(char)) intersection += 1;
  }
  const union = leftChars.size + rightChars.size - intersection;
  return union === 0 ? 0 : intersection / union;
}

/** 主键只取 phrase（normalize 后），不再带 kind/intent —— 这是「同句双存」的根因。 */
export function patternPhraseKey(phrase: string): string {
  return phrase.replace(/\s+/g, " ").trim();
}

function byScore(left: GlobalPattern, right: GlobalPattern): number {
  return patternScore(right) - patternScore(left);
}

/** Σfrequency × channels.length × (0.5 + salience)；老数据无 salience 时按 0.5 计，倍率仍为 1.0。 */
function patternScore(pattern: GlobalPattern): number {
  const salience = typeof pattern.salience === "number" ? clampSalience(pattern.salience) : 0.5;
  return pattern.channels.reduce((total, channel) => total + channel.frequency, 0) * pattern.channels.length * (0.5 + salience);
}

function chainKey(chain: readonly string[]): string {
  return chain.join(">");
}

function byChainScore(left: GlobalChainPattern, right: GlobalChainPattern): number {
  return chainScore(right) - chainScore(left);
}

function chainScore(chain: GlobalChainPattern): number {
  return chain.channels.reduce((total, channel) => total + channel.frequency, 0) * chain.channels.length;
}

function channelFingerprint(scopeKey: string): string {
  return createHash("sha256").update(scopeKey).digest("hex").slice(0, 16);
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null;
}

function normalizePattern(value: unknown): GlobalPattern | undefined {
  if (!isRecord(value)) return undefined;
  const phrase = typeof value.phrase === "string" ? value.phrase.trim() : "";
  if (phrase.length === 0) return undefined;
  const kind: GlobalPatternKind = value.kind === "initiation" ? "initiation" : "response";
  const intent = typeof value.intent === "string" && value.intent.length > 0 ? value.intent : "ack";
  const kinds = Array.isArray(value.kinds)
    ? value.kinds.filter((item): item is GlobalPatternKind => item === "response" || item === "initiation")
    : [];
  const intents = Array.isArray(value.intents) ? value.intents.filter((item): item is string => typeof item === "string" && item.length > 0) : [];
  const channels = Array.isArray(value.channels)
    ? value.channels
        .filter(isRecord)
        .map((channel) => ({
          key: typeof channel.key === "string" ? channel.key : "",
          frequency: typeof channel.frequency === "number" && Number.isFinite(channel.frequency) ? channel.frequency : 1,
          lastSeenAt: typeof channel.lastSeenAt === "number" ? channel.lastSeenAt : 0,
        }))
        .filter((channel) => channel.key.length > 0)
    : [];
  const firstSeenAt = typeof value.firstSeenAt === "number" ? value.firstSeenAt : 0;
  const lastSeenAt = typeof value.lastSeenAt === "number" ? value.lastSeenAt : firstSeenAt;
  const variants = Array.isArray(value.variants) ? value.variants.filter((item): item is string => typeof item === "string") : undefined;
  const salience = typeof value.salience === "number" && Number.isFinite(value.salience) ? clampSalience(value.salience) : undefined;
  const hits = typeof value.hits === "number" && Number.isFinite(value.hits) ? value.hits : undefined;
  const embedding = Array.isArray(value.embedding) && value.embedding.every((item) => typeof item === "number") ? (value.embedding as number[]) : undefined;
  return {
    kind,
    intent,
    kinds: kinds.length > 0 ? kinds : [kind],
    intents: intents.length > 0 ? intents : [intent],
    phrase,
    channels,
    firstSeenAt,
    lastSeenAt,
    ...(variants && variants.length > 0 ? { variants: variants.slice(-MAX_VARIANTS) } : {}),
    ...(salience !== undefined ? { salience } : {}),
    ...(hits !== undefined ? { hits } : {}),
    ...(embedding ? { embedding: [...embedding] } : {}),
  };
}

/** 加载时按 phrase 去重 + 迁移老数据；对已合并的数据幂等。 */
function normalizePatternRows(rows: readonly GlobalPattern[]): readonly GlobalPattern[] {
  const byPhrase = new Map<string, GlobalPattern>();
  for (const row of rows) {
    const key = patternPhraseKey(row.phrase);
    const existing = byPhrase.get(key);
    if (!existing) {
      byPhrase.set(key, row);
      continue;
    }
    byPhrase.set(key, {
      ...existing,
      kinds: [...new Set([...kindsOf(existing), ...kindsOf(row)])],
      intents: [...new Set([...intentsOf(existing), ...intentsOf(row)])],
      ...(() => {
        const merged = [...new Set([...(existing.variants ?? []), ...(row.variants ?? [])])].slice(-MAX_VARIANTS);
        return merged.length > 0 ? { variants: merged } : {};
      })(),
      channels: unionChannelStats(existing.channels, row.channels),
      firstSeenAt: Math.min(existing.firstSeenAt, row.firstSeenAt),
      lastSeenAt: Math.max(existing.lastSeenAt, row.lastSeenAt),
      ...(existing.salience !== undefined || row.salience !== undefined
        ? { salience: Math.max(existing.salience ?? 0, row.salience ?? 0) }
        : {}),
      hits: (existing.hits ?? 0) + (row.hits ?? 0) > 0 ? (existing.hits ?? 0) + (row.hits ?? 0) : undefined,
      ...(existing.embedding ? { embedding: [...existing.embedding] } : row.embedding ? { embedding: [...row.embedding] } : {}),
    });
  }
  return [...byPhrase.values()];
}

/** 同 key 频道取 max frequency：沿用「覆盖不累加」语义，重放历史不会膨胀。 */
function unionChannelStats(
  left: readonly { key: string; frequency: number; lastSeenAt: number }[],
  right: readonly { key: string; frequency: number; lastSeenAt: number }[],
): readonly { key: string; frequency: number; lastSeenAt: number }[] {
  const merged = new Map<string, { key: string; frequency: number; lastSeenAt: number }>();
  for (const channel of [...left, ...right]) {
    const existing = merged.get(channel.key);
    if (!existing) {
      merged.set(channel.key, { ...channel });
      continue;
    }
    merged.set(channel.key, {
      key: channel.key,
      frequency: Math.max(existing.frequency, channel.frequency),
      lastSeenAt: Math.max(existing.lastSeenAt, channel.lastSeenAt),
    });
  }
  return [...merged.values()];
}

function normalizeBoundary(value: unknown): BoundaryMemory | undefined {
  if (!isRecord(value)) return undefined;
  const text = typeof value.text === "string" ? value.text : "";
  if (text.length === 0) return undefined;
  // 老数据没有 id 时按「频道 + 文本」补一个，与写侧规则一致。
  const fallbackChannelKey = typeof value.channelKey === "string" ? value.channelKey : "";
  const id = typeof value.id === "string" && value.id.length > 0 ? value.id : boundaryId(fallbackChannelKey, text);
  const strength = typeof value.strength === "number" && Number.isFinite(value.strength) ? clampSalience(value.strength) : 0.5;
  return {
    id,
    text,
    channelKey: typeof value.channelKey === "string" ? value.channelKey : "",
    firstSeenAt: typeof value.firstSeenAt === "number" ? value.firstSeenAt : 0,
    lastSeenAt: typeof value.lastSeenAt === "number" ? value.lastSeenAt : 0,
    strength,
    hits: typeof value.hits === "number" && Number.isFinite(value.hits) ? value.hits : 1,
    ...(typeof value.revokedAt === "number" ? { revokedAt: value.revokedAt } : {}),
  };
}

export function normalizeGlobalRuleBank(value: unknown): GlobalRuleBank {
  const parsed = (typeof value === "object" && value !== null ? value : {}) as Partial<GlobalRuleBank>;
  const patterns = Array.isArray(parsed.patterns)
    ? normalizePatternRows(parsed.patterns.map(normalizePattern).filter((pattern): pattern is GlobalPattern => pattern !== undefined)).map((pattern) =>
        typeof pattern.salience === "number" ? pattern : { ...pattern, salience: clampSalience(computeSalience(pattern.phrase)) },
      )
    : [];
  const boundaries = Array.isArray(parsed.boundaries)
    ? parsed.boundaries.map(normalizeBoundary).filter((boundary): boundary is BoundaryMemory => boundary !== undefined)
    : [];
  return {
    version: typeof parsed.version === "number" ? parsed.version : 1,
    updatedAt: typeof parsed.updatedAt === "number" ? parsed.updatedAt : Date.now(),
    patterns: [...patterns].sort(byScore),
    chains: Array.isArray(parsed.chains) ? parsed.chains : [],
    templates: Array.isArray(parsed.templates) ? parsed.templates : [],
    boundaries,
  };
}
